# Template for <repo>/.env.secrets — E2E test-account credentials.
# Copy to .env.secrets (gitignored) and fill in the real values.
#
# The three e2e accounts are real, plus-addressed users in the LIVE auth pool,
# created via public signup and then confirmed/approved/promoted by SQL:
#   skytwech+e2e-advisor@gmail.com    → users.role 'advisor'
#   skytwech+e2e-manager@gmail.com    → users.role 'manager' (+ profiles.role mirror)
#   skytwech+e2e-superadmin@gmail.com → users.role 'super_admin'
# All three must be email-confirmed + is_approved=true to pass login.
#
# Consumed by tests/fixtures/testUsers.ts (auth.setup.ts → tests/.auth/<role>.json
# storageStates) and tests/fixtures/roleAuth.ts loginAs(). In CI, set these as
# env vars directly instead of using a file.

TEST_ADVISOR_EMAIL=skytwech+e2e-advisor@gmail.com
TEST_ADVISOR_PASSWORD=changeme

TEST_MANAGER_EMAIL=skytwech+e2e-manager@gmail.com
TEST_MANAGER_PASSWORD=changeme

TEST_SUPER_ADMIN_EMAIL=skytwech+e2e-superadmin@gmail.com
TEST_SUPER_ADMIN_PASSWORD=changeme

# Optional — service-role key for tests/runners/supabaseChecks.ts evidence
# helpers (bypasses RLS). Only needed by specs that import that module.
# SUPABASE_URL=https://mymzcbalyqqgdmzsfmam.supabase.co
# SUPABASE_KEY=changeme
