{
  "name": "prospect-profiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint . --max-warnings=15",
    "preview": "vite preview",
    "db:schema": "supabase db dump --schema public -f supabase/remote_public_schema.sql",
    "db:types": "supabase gen types typescript --schema public --linked > supabase/remote_types.ts",
    "db:data": "sh -c 'test -n \"$DB_URL_RO\" && supabase db dump --db-url \"$DB_URL_RO\" --data-only --schema public -f supabase/remote_public_data.sql || (echo \"DB_URL_RO is not set. Skipping data dump.\" && exit 0)'",
    "db:refresh": "bash scripts/refresh_supabase_snapshots.sh",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:8080",
    "test:e2e:p0": "playwright test --grep @p0",
    "test:e2e:smoke-folder": "playwright test tests/workflows/smoke",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:pushgate": "playwright test --grep @pushgate",
    "test:e2e:comprehensive": "playwright test --config=playwright.comprehensive.config.ts",
    "test:e2e:failed": "playwright test --last-failed",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:mobile": "playwright test --project=mobile-safari",
    "drift:check": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json src",
    "drift:all": "depcruise --config .dependency-cruiser.cjs src",
    "drift:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > drift.svg",
    "drift:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline src > .dependency-cruiser-known-violations.json",
    "loc:check": "node scripts/loc-ratchet.mjs",
    "loc:baseline": "node scripts/loc-ratchet.mjs --update",
    "prepare": "husky",
    "knip": "knip",
    "knip:production": "knip --production",
    "check:repo": "bash scripts/check-repo.sh"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@hookform/resolvers": "^3.9.0",
    "@pdfsmaller/pdf-encrypt-lite": "^1.0.1",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/extension-placeholder": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@turf/boolean-point-in-polygon": "^7.3.0",
    "@turf/boolean-point-on-line": "^7.3.0",
    "@turf/distance": "^7.3.0",
    "@turf/helpers": "^7.3.0",
    "@types/leaflet": "^1.9.20",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.3",
    "embla-carousel-react": "^8.3.0",
    "exceljs": "^4.4.0",
    "graphql": "^16.11.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.2.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.462.0",
    "motion": "^12.38.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-with-encrypt": "^1.2.1",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-photo-view": "^1.2.7",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tus-js-client": "^4.3.1",
    "vaul": "^0.9.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/html2canvas": "^0.5.35",
    "@types/jspdf": "^2.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.2.2",
    "dependency-cruiser": "^17.3.10",
    "dotenv": "^16.6.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "knip": "^6.14.2",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{js,jsx,json,md,yml,yaml}": []
  }
}
