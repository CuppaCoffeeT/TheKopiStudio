# Copy this file to `.env` and fill in your Supabase project's values.
# The anon/publishable key is safe to expose in the browser — security is in RLS.

# Supabase project ref (the subdomain of your project URL)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Optional test-mode flags (used by e2e harness)
VITE_EMAIL_TEST_MODE=false
VITE_TEST_EMAIL_OVERRIDE=test@example.com
