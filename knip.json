{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "index.html",
    "vite.config.ts",
    "tailwind.config.ts",
    "playwright.config.ts",
    "playwright.parallel.config.ts",
