{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "index.html",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.parallel.config.ts",
    "tests/**/*.spec.ts",
    "tests/auth.setup.ts",
    "scripts/**",
    "supabase/functions/**",
    "playwright.comprehensive.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/integrations/supabase/types.ts",
    "**/*.d.ts",
    "dist/**"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tailwindcss-animate",
    "@tailwindcss/typography"
  ]
}
